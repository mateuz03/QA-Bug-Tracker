generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum RequirementStatus {
  DRAFT
  READY
  COVERED
  BLOCKED
}

enum ScenarioType {
  FUNCTIONAL
  REGRESSION
  SMOKE
  INTEGRATION
}

enum ScenarioStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum StepAction {
  NAVIGATE
  FILL
  CLICK
  SELECT
  CHECK
  UPLOAD
  ASSERT_TEXT
  ASSERT_VISIBLE
  ASSERT_URL
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  BLOCKED
  CANCELLED
}

enum ExecutionStepStatus {
  PENDING
  PASSED
  FAILED
  SKIPPED
}

enum ExecutionLogLevel {
  INFO
  WARN
  ERROR
}

enum ScreenshotMode {
  NONE
  FAILURE
  ALL
}

enum EvidenceType {
  SCREENSHOT
  VIDEO
  TRACE
  CONSOLE
  NETWORK
  MANUAL
}

enum RecordingStatus {
  RECORDING
  REVIEW
  SAVED
  CANCELLED
}

model User {
  id                Int                 @id @default(autoincrement())
  name              String
  email             String              @unique
  passwordHash      String
  role              Role                @default(ANALYST)
  active            Boolean             @default(true)
  assignedBugs      Bug[]               @relation("BugAssignee")
  createdBugs       Bug[]               @relation("BugReporter")
  ownedProjects     Project[]           @relation("ProjectOwner")
  executions        TestExecution[]
  uploadedEvidences ExecutionEvidence[]
  recordings        RecordingSession[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model Bug {
  id             Int            @id @default(autoincrement())
  code           String         @unique
  title          String
  description    String
  reproduction   String?
  expectedResult String?
  actualResult   String?
  severity       Severity       @default(MEDIUM)
  priority       Priority       @default(MEDIUM)
  environment    String?
  browser        String?
  status         BugStatus      @default(OPEN)
  evidenceUrl    String?
  technicalError String?
  assigneeId     Int?
  reporterId     Int
  projectId      Int?
  scenarioId     Int?
  executionId    Int?
  assignee       User?          @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter       User           @relation("BugReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  scenario       TestScenario?  @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  execution      TestExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([priority])
  @@index([severity])
  @@index([assigneeId])
  @@index([projectId])
  @@index([scenarioId])
  @@index([executionId])
  @@index([createdAt])
}

model Project {
  id            Int                @id @default(autoincrement())
  code          String             @unique
  name          String
  description   String?
  repositoryUrl String?
  status        ProjectStatus      @default(ACTIVE)
  ownerId       Int
  owner         User               @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  environments  Environment[]
  requirements  Requirement[]
  scenarios     TestScenario[]
  executions    TestExecution[]
  recordings    RecordingSession[]
  bugs          Bug[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Environment {
  id         Int             @id @default(autoincrement())
  name       String
  baseUrl    String
  isDefault  Boolean         @default(false)
  projectId  Int
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions TestExecution[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([projectId, name])
}

model Requirement {
  id          Int               @id @default(autoincrement())
  code        String            @unique
  title       String
  description String
  status      RequirementStatus @default(READY)
  projectId   Int
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenarios   TestScenario[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([projectId])
}

model TestScenario {
  id             Int                @id @default(autoincrement())
  code           String             @unique
  title          String
  description    String?
  preconditions  String?
  priority       Priority           @default(MEDIUM)
  type           ScenarioType       @default(FUNCTIONAL)
  status         ScenarioStatus     @default(ACTIVE)
  automated      Boolean            @default(false)
  timeoutMs      Int                @default(60000)
  screenshotMode ScreenshotMode     @default(FAILURE)
  captureVideo   Boolean            @default(true)
  captureTrace   Boolean            @default(true)
  captureConsole Boolean            @default(true)
  captureNetwork Boolean            @default(true)
  retentionDays  Int                @default(30)
  projectId      Int
  requirementId  Int?
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement    Requirement?       @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  steps          ScenarioStep[]
  executions     TestExecution[]
  recordings     RecordingSession[]
  bugs           Bug[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([projectId])
  @@index([requirementId])
}

model ScenarioStep {
  id          Int          @id @default(autoincrement())
  order       Int
  action      StepAction
  description String
  target      String?
  value       String?
  expected    String?
  timeoutMs   Int?
  scenarioId  Int
  scenario    TestScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([scenarioId, order])
}

model TestExecution {
  id                Int                 @id @default(autoincrement())
  code              String              @unique
  status            ExecutionStatus     @default(QUEUED)
  browser           String              @default("chromium")
  durationMs        Int?
  timeoutMs         Int                 @default(60000)
  screenshotMode    ScreenshotMode      @default(FAILURE)
  captureVideo      Boolean             @default(true)
  captureTrace      Boolean             @default(true)
  captureConsole    Boolean             @default(true)
  captureNetwork    Boolean             @default(true)
  retentionUntil    DateTime?
  progress          Int                 @default(0)
  currentStep       Int?
  errorMessage      String?
  screenshotPath    String?
  cancelRequestedAt DateTime?
  heartbeatAt       DateTime?
  retryOfId         Int?
  scenarioId        Int
  environmentId     Int
  projectId         Int
  createdById       Int
  scenario          TestScenario        @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  environment       Environment         @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy         User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  steps             ExecutionStep[]
  logs              ExecutionLog[]
  evidences         ExecutionEvidence[]
  bugs              Bug[]
  retryOf           TestExecution?      @relation("ExecutionRetries", fields: [retryOfId], references: [id], onDelete: SetNull)
  retries           TestExecution[]     @relation("ExecutionRetries")
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([projectId])
  @@index([scenarioId])
  @@index([status])
  @@index([retryOfId])
}

model ExecutionStep {
  id          Int                 @id @default(autoincrement())
  order       Int
  description String
  action      StepAction          @default(NAVIGATE)
  status      ExecutionStepStatus @default(PENDING)
  durationMs  Int?
  error       String?
  expected    String?
  actual      String?
  startedAt   DateTime?
  finishedAt  DateTime?
  executionId Int
  execution   TestExecution       @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, order])
}

model ExecutionEvidence {
  id           Int           @id @default(autoincrement())
  type         EvidenceType
  name         String
  path         String
  mimeType     String
  sizeBytes    Int
  description  String?
  stepOrder    Int?
  executionId  Int
  uploadedById Int?
  execution    TestExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())

  @@index([executionId, createdAt])
  @@index([uploadedById])
}

model ExecutionLog {
  id          Int               @id @default(autoincrement())
  level       ExecutionLogLevel @default(INFO)
  message     String
  stepOrder   Int?
  executionId Int
  execution   TestExecution     @relation(fields: [executionId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@index([executionId, createdAt])
}

model RecordingSession {
  id          Int             @id @default(autoincrement())
  code        String          @unique
  title       String
  status      RecordingStatus @default(RECORDING)
  projectId   Int
  scenarioId  Int?
  createdById Int
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenario    TestScenario?   @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  events      RecordedEvent[]
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model RecordedEvent {
  id        Int              @id @default(autoincrement())
  order     Int
  action    StepAction
  url       String?
  selector  String?
  value     String?
  text      String?
  sessionId Int
  session   RecordingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([sessionId, order])
}
