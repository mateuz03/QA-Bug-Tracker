generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
}

enum ProjectRole {
  OWNER
  MANAGER
  VIEWER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum RequirementStatus {
  DRAFT
  READY
  COVERED
  BLOCKED
}

enum ScenarioType {
  FUNCTIONAL
  REGRESSION
  SMOKE
  INTEGRATION
}

enum ScenarioStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum StepAction {
  NAVIGATE
  FILL
  CLICK
  SELECT
  CHECK
  UPLOAD
  ASSERT_TEXT
  ASSERT_VISIBLE
  ASSERT_URL
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  PASSED
  FAILED
  BLOCKED
  CANCELLED
}

enum ExecutionStepStatus {
  PENDING
  PASSED
  FAILED
  SKIPPED
}

enum ExecutionLogLevel {
  INFO
  WARN
  ERROR
}

enum ScreenshotMode {
  NONE
  FAILURE
  ALL
}

enum EvidenceType {
  SCREENSHOT
  VIDEO
  TRACE
  CONSOLE
  NETWORK
  MANUAL
}

enum RecordingStatus {
  RECORDING
  REVIEW
  SAVED
  CANCELLED
}

enum TestPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TestCycleStatus {
  PLANNED
  RUNNING
  COMPLETED
  CANCELLED
}

enum CycleScenarioResult {
  NOT_RUN
  PASSED
  FAILED
  BLOCKED
}

enum ExternalIssueProvider {
  GITHUB
  JIRA
}

model User {
  id                     Int                 @id @default(autoincrement())
  name                   String
  email                  String              @unique
  passwordHash           String
  role                   Role                @default(ANALYST)
  active                 Boolean             @default(true)
  assignedBugs           Bug[]               @relation("BugAssignee")
  createdBugs            Bug[]               @relation("BugReporter")
  ownedProjects          Project[]           @relation("ProjectOwner")
  executions             TestExecution[]
  uploadedEvidences      ExecutionEvidence[]
  recordings             RecordingSession[]
  createdTestPlans       TestPlan[]          @relation("TestPlanCreator")
  createdTestSuites      TestSuite[]         @relation("TestSuiteCreator")
  createdTestCycles      TestCycle[]         @relation("TestCycleCreator")
  executedCycleScenarios TestCycleScenario[] @relation("CycleScenarioExecutor")
  projectMemberships     ProjectMember[]
  auditLogs              AuditLog[]
  createdProjectApiKeys  ProjectApiKey[]
  configuredGitHub       GitHubIntegration[]
  configuredJira         JiraIntegration[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
}

model Bug {
  id             Int                @id @default(autoincrement())
  code           String             @unique
  title          String
  description    String
  reproduction   String?
  expectedResult String?
  actualResult   String?
  severity       Severity           @default(MEDIUM)
  priority       Priority           @default(MEDIUM)
  environment    String?
  browser        String?
  status         BugStatus          @default(OPEN)
  evidenceUrl    String?
  technicalError String?
  assigneeId     Int?
  reporterId     Int
  projectId      Int?
  scenarioId     Int?
  executionId    Int?
  assignee       User?              @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter       User               @relation("BugReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  project        Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  scenario       TestScenario?      @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  execution      TestExecution?     @relation(fields: [executionId], references: [id], onDelete: SetNull)
  externalIssues BugExternalIssue[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status])
  @@index([priority])
  @@index([severity])
  @@index([assigneeId])
  @@index([projectId])
  @@index([scenarioId])
  @@index([executionId])
  @@index([createdAt])
}

model BugExternalIssue {
  id           Int                   @id @default(autoincrement())
  provider     ExternalIssueProvider
  externalKey  String
  url          String
  state        String
  lastSyncedAt DateTime?
  lastError    String?
  metadata     Json?
  bugId        Int
  bug          Bug                   @relation(fields: [bugId], references: [id], onDelete: Cascade)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([bugId, provider])
  @@index([provider, externalKey])
}

model Project {
  id            Int                @id @default(autoincrement())
  code          String             @unique
  name          String
  description   String?
  repositoryUrl String?
  status        ProjectStatus      @default(ACTIVE)
  ownerId       Int
  owner         User               @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  environments  Environment[]
  requirements  Requirement[]
  scenarios     TestScenario[]
  executions    TestExecution[]
  recordings    RecordingSession[]
  bugs          Bug[]
  testPlans     TestPlan[]
  testSuites    TestSuite[]
  members       ProjectMember[]
  auditLogs     AuditLog[]
  apiKeys       ProjectApiKey[]
  github        GitHubIntegration?
  jira          JiraIntegration?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model ProjectMember {
  projectId Int
  userId    Int
  role      ProjectRole @default(VIEWER)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@id([projectId, userId])
  @@index([userId, role])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   String?
  details    Json?
  projectId  Int
  actorId    Int
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
}

model ProjectApiKey {
  id          Int       @id @default(autoincrement())
  name        String
  prefix      String    @unique
  keyHash     String    @unique
  projectId   Int
  createdById Int
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([projectId, revokedAt])
  @@index([expiresAt])
}

model GitHubIntegration {
  id              Int       @id @default(autoincrement())
  projectId       Int       @unique
  repositoryOwner String
  repositoryName  String
  tokenEncrypted  String
  tokenIv         String
  tokenTag        String
  enabled         Boolean   @default(true)
  createdById     Int
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lastPublishedAt DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled])
  @@index([createdById])
}

model JiraIntegration {
  id             Int       @id @default(autoincrement())
  projectId      Int       @unique
  siteUrl        String
  email          String
  jiraProjectKey String
  issueType      String    @default("Bug")
  tokenEncrypted String
  tokenIv        String
  tokenTag       String
  enabled        Boolean   @default(true)
  createdById    Int
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lastSyncedAt   DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([enabled])
  @@index([createdById])
}

model Environment {
  id         Int             @id @default(autoincrement())
  name       String
  baseUrl    String
  isDefault  Boolean         @default(false)
  projectId  Int
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions TestExecution[]
  testCycles TestCycle[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([projectId, name])
}

model Requirement {
  id          Int               @id @default(autoincrement())
  code        String            @unique
  title       String
  description String
  status      RequirementStatus @default(READY)
  projectId   Int
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenarios   TestScenario[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([projectId])
}

model TestScenario {
  id             Int                 @id @default(autoincrement())
  code           String              @unique
  title          String
  description    String?
  preconditions  String?
  priority       Priority            @default(MEDIUM)
  type           ScenarioType        @default(FUNCTIONAL)
  status         ScenarioStatus      @default(ACTIVE)
  automated      Boolean             @default(false)
  timeoutMs      Int                 @default(60000)
  screenshotMode ScreenshotMode      @default(FAILURE)
  captureVideo   Boolean             @default(true)
  captureTrace   Boolean             @default(true)
  captureConsole Boolean             @default(true)
  captureNetwork Boolean             @default(true)
  retentionDays  Int                 @default(30)
  projectId      Int
  requirementId  Int?
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement    Requirement?        @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  steps          ScenarioStep[]
  executions     TestExecution[]
  recordings     RecordingSession[]
  bugs           Bug[]
  suiteItems     TestSuiteScenario[]
  cycleItems     TestCycleScenario[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([projectId])
  @@index([requirementId])
}

model ScenarioStep {
  id          Int          @id @default(autoincrement())
  order       Int
  action      StepAction
  description String
  target      String?
  value       String?
  expected    String?
  timeoutMs   Int?
  scenarioId  Int
  scenario    TestScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([scenarioId, order])
}

model TestExecution {
  id                Int                 @id @default(autoincrement())
  code              String              @unique
  status            ExecutionStatus     @default(QUEUED)
  browser           String              @default("chromium")
  durationMs        Int?
  timeoutMs         Int                 @default(60000)
  screenshotMode    ScreenshotMode      @default(FAILURE)
  captureVideo      Boolean             @default(true)
  captureTrace      Boolean             @default(true)
  captureConsole    Boolean             @default(true)
  captureNetwork    Boolean             @default(true)
  retentionUntil    DateTime?
  progress          Int                 @default(0)
  currentStep       Int?
  errorMessage      String?
  screenshotPath    String?
  cancelRequestedAt DateTime?
  heartbeatAt       DateTime?
  retryOfId         Int?
  cycleId           Int?
  commitSha         String?
  pipelineSource    String?
  scenarioId        Int
  environmentId     Int
  projectId         Int
  createdById       Int
  scenario          TestScenario        @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  environment       Environment         @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy         User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  steps             ExecutionStep[]
  logs              ExecutionLog[]
  evidences         ExecutionEvidence[]
  bugs              Bug[]
  retryOf           TestExecution?      @relation("ExecutionRetries", fields: [retryOfId], references: [id], onDelete: SetNull)
  retries           TestExecution[]     @relation("ExecutionRetries")
  cycle             TestCycle?          @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([projectId])
  @@index([scenarioId])
  @@index([status])
  @@index([retryOfId])
  @@index([cycleId])
  @@index([commitSha])
}

model ExecutionStep {
  id          Int                 @id @default(autoincrement())
  order       Int
  description String
  action      StepAction          @default(NAVIGATE)
  status      ExecutionStepStatus @default(PENDING)
  durationMs  Int?
  error       String?
  expected    String?
  actual      String?
  startedAt   DateTime?
  finishedAt  DateTime?
  executionId Int
  execution   TestExecution       @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, order])
}

model ExecutionEvidence {
  id           Int           @id @default(autoincrement())
  type         EvidenceType
  name         String
  path         String
  mimeType     String
  sizeBytes    Int
  description  String?
  stepOrder    Int?
  executionId  Int
  uploadedById Int?
  execution    TestExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())

  @@index([executionId, createdAt])
  @@index([uploadedById])
}

model ExecutionLog {
  id          Int               @id @default(autoincrement())
  level       ExecutionLogLevel @default(INFO)
  message     String
  stepOrder   Int?
  executionId Int
  execution   TestExecution     @relation(fields: [executionId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@index([executionId, createdAt])
}

model RecordingSession {
  id          Int             @id @default(autoincrement())
  code        String          @unique
  title       String
  status      RecordingStatus @default(RECORDING)
  projectId   Int
  scenarioId  Int?
  createdById Int
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenario    TestScenario?   @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  createdBy   User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  events      RecordedEvent[]
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model RecordedEvent {
  id        Int              @id @default(autoincrement())
  order     Int
  action    StepAction
  url       String?
  selector  String?
  value     String?
  text      String?
  sessionId Int
  session   RecordingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([sessionId, order])
}

model TestPlan {
  id             Int             @id @default(autoincrement())
  code           String          @unique
  name           String
  description    String?
  objective      String?
  releaseVersion String?
  status         TestPlanStatus  @default(DRAFT)
  projectId      Int
  createdById    Int
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("TestPlanCreator", fields: [createdById], references: [id], onDelete: Restrict)
  suites         TestPlanSuite[]
  cycles         TestCycle[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([projectId, status])
  @@index([createdById])
}

model TestSuite {
  id          Int                 @id @default(autoincrement())
  code        String              @unique
  name        String
  description String?
  projectId   Int
  createdById Int
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy   User                @relation("TestSuiteCreator", fields: [createdById], references: [id], onDelete: Restrict)
  plans       TestPlanSuite[]
  scenarios   TestSuiteScenario[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([projectId])
  @@index([createdById])
}

model TestPlanSuite {
  planId    Int
  suiteId   Int
  order     Int       @default(1)
  plan      TestPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  suite     TestSuite @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([planId, suiteId])
  @@unique([planId, order])
  @@index([suiteId])
}

model TestSuiteScenario {
  suiteId    Int
  scenarioId Int
  order      Int          @default(1)
  suite      TestSuite    @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  scenario   TestScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@id([suiteId, scenarioId])
  @@unique([suiteId, order])
  @@index([scenarioId])
}

model TestCycle {
  id            Int                 @id @default(autoincrement())
  code          String              @unique
  name          String
  description   String?
  status        TestCycleStatus     @default(PLANNED)
  browser       String              @default("chromium")
  plannedStart  DateTime?
  plannedEnd    DateTime?
  scheduledAt   DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  planId        Int
  environmentId Int
  createdById   Int
  plan          TestPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  environment   Environment         @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  createdBy     User                @relation("TestCycleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  scenarios     TestCycleScenario[]
  executions    TestExecution[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([planId, status])
  @@index([status, scheduledAt])
  @@index([environmentId])
  @@index([createdById])
}

model TestCycleScenario {
  cycleId      Int
  scenarioId   Int
  order        Int                 @default(1)
  result       CycleScenarioResult @default(NOT_RUN)
  notes        String?
  executedById Int?
  executedAt   DateTime?
  cycle        TestCycle           @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  scenario     TestScenario        @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  executedBy   User?               @relation("CycleScenarioExecutor", fields: [executedById], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt

  @@id([cycleId, scenarioId])
  @@unique([cycleId, order])
  @@index([scenarioId])
  @@index([executedById])
}
