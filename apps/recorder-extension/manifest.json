{
  "manifest_version": 3,
  "name": "QA Truker Recorder",
  "version": "0.1.0",
  "description": "Grava navegação, cliques e preenchimentos para criar cenários no QA Truker.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["http://localhost:3001/*", "http://127.0.0.1:3001/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QA Truker Recorder"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
